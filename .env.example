# Auth.js / NextAuth
AUTH_SECRET=          # genera uno con: npx auth secret
AUTH_GOOGLE_ID=       # Google Cloud Console > OAuth Client ID (Web application)
AUTH_GOOGLE_SECRET=

# Groq — scoring de empleos y generación de CV/cover letter (gratis, cuota
# generosa y estable: 14.400 peticiones/día en llama-3.1-8b-instant)
# Consíguela en https://console.groq.com/keys
GROQ_API_KEY=

# Fuentes de empleo
JOOBLE_API_KEY=       # gratis en https://jooble.org/api/about
# Remotive, Arbeitnow, RemoteOK, WeWorkRemotely y Working Nomads no necesitan
# API key, se activan solas.
# (Careerjet se descartó: exige declarar IPs fijas de servidor, incompatible
# con las funciones serverless de Vercel, que no tienen IP de salida fija.
# Adzuna se descartó: su WAF bloquea las IPs de los datacenters de Vercel con
# un 400, incluso con credenciales válidas y la petición bien formada.)

# Búsqueda automática en segundo plano (opcional, ver README "Automatización")
CRON_SECRET=          # cualquier cadena aleatoria, debe coincidir en Vercel
GOOGLE_REFRESH_TOKEN= # se obtiene desde /profile tras el primer login
NOTIFY_EMAIL=         # tu email de Gmail, para el digest de notificaciones
